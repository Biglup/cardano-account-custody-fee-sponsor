      ]
    },
    "cardano_account_custody_contract/types/MintRedeemer": {
      "title": "MintRedeemer",
      "description": "The redeemer for the account validator's mint handler, which creates\n the account's state NFT. The NFT is never burned, so creation is the\n handler's only purpose and `CreateAccount` its only value.",
      "anyOf": [
        {
          "title": "CreateAccount",
          "dataType": "constructor",
          "index": 0,
          "fields": []
        }
      ]
    },
    "cardano_account_custody_contract/types/StakeRedeemer": {
      "title": "StakeRedeemer",
      "description": "The redeemer for the account stake validator's withdraw and publish\n handlers. Both handlers learn what they are authorising from the script\n context itself, the credential a withdrawal draws from or the\n certificate being published, so the redeemer carries no choice and\n `Operate` is its only value.",
      "anyOf": [
