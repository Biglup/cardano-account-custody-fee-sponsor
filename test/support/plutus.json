    "cardano_account_custody_contract/types/AccountRedeemer": {
      "title": "AccountRedeemer",
      "description": "The redeemer for the account validator's spend handler.\n\n `Device` is the owner path: any device key may rewrite the state freely,\n as long as the result stays well formed. `SpendWithGrant` is the agent\n path: the grantee of the named grant signs the transaction as a required\n signer, and the grant's remaining caps bound what the transaction may\n take. `Fund` is for a plain deposit UTxO at the account address, which\n only requires that the account's own state NFT is spent alongside it.",
      "anyOf": [
        {
          "title": "Device",
          "dataType": "constructor",
          "index": 0,
          "fields": []
        },
